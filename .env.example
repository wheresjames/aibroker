NODE_ENV=development
AIBROKER_API_PORT=8080
AIBROKER_WEB_PORT=3000
AIBROKER_PUBLIC_URL=http://localhost:8080
AIBROKER_DATABASE_URL=postgres://aibroker:aibroker@postgres:5432/aibroker
AIBROKER_REDIS_URL=redis://redis:6379
AIBROKER_SESSION_SECRET=replace_with_at_least_32_chars
AIBROKER_ENCRYPTION_KEY_BASE64=replace_with_32_byte_base64_key
AIBROKER_ALLOW_PRIVATE_CONNECTOR_TARGETS=false
AIBROKER_MCP_ENABLED=false
AIBROKER_SANDBOX_ENABLED=true
# Opt-in full-fidelity MCP capture: when true, the tool-call path encrypts the
# request input + result/error into audit_events.encrypted_payload (still redacted
# for secrets) so the admin MCP monitor can reveal/export full bodies. Off by default.
AIBROKER_MCP_CAPTURE_BODIES=false
AIBROKER_BROWSER_WORKER_URL=http://aibroker-browser-worker:8090
AIBROKER_BROWSER_WORKER_SECRET=replace_with_a_dedicated_random_secret
AIBROKER_BROWSER_RPC_TIMEOUT_MS=35000
AIBROKER_BROWSER_MAX_CONCURRENT=4
AIBROKER_BROWSER_MAX_SESSIONS=20
AIBROKER_BROWSER_ALLOW_PRIVATE_TARGETS=true
AIBROKER_ARTIFACT_BACKEND=filesystem
AIBROKER_ALLOW_FILESYSTEM_ARTIFACTS=false
AIBROKER_ARTIFACT_FILESYSTEM_ROOT=/data/artifacts
AIBROKER_ARTIFACT_DEFAULT_RETENTION_SECONDS=86400
AIBROKER_ARTIFACT_MAX_RETENTION_SECONDS=604800
# Production uses AIBROKER_ARTIFACT_BACKEND=s3 and supplies all values below.
AIBROKER_ARTIFACT_S3_ENDPOINT=
AIBROKER_ARTIFACT_S3_REGION=
AIBROKER_ARTIFACT_S3_BUCKET=
AIBROKER_ARTIFACT_S3_ACCESS_KEY_ID=
AIBROKER_ARTIFACT_S3_SECRET_ACCESS_KEY=
AIBROKER_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
AIBROKER_BOOTSTRAP_ADMIN_PASSWORD=change_me_in_local_dev
AIBROKER_BOOTSTRAP_ADMIN_NAME=AIBroker Admin
WORDPRESS_DB_HOST=wordpress-db
WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_USER=wordpress
WORDPRESS_DB_PASSWORD=wordpress
